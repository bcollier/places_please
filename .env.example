# Copy to .env.local and fill in from Supabase: Project Settings › API.
# These are PUBLIC values (they ship inside the app). Row level security protects the data.
# Never put the OpenRouter key or the Supabase service_role key here — those go in Supabase secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
